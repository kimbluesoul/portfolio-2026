{
  "name": "portfolio-2026",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "prepare": "node scripts/prepare-font-subsets.mjs",
    "dev": "astro dev",
    "preview": "astro preview",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\"",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "check": "astro check",
    "test": "vitest run",
    "font:prepare": "node scripts/prepare-font-subsets.mjs",
    "font:subset": "node scripts/subset-fonts.mjs",
    "build": "pnpm font:prepare && astro build && pnpm font:subset && astro build && node scripts/check-font-coverage.mjs && node scripts/check-media.mjs && node scripts/check-bundles.mjs",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "verify": "pnpm lint && pnpm format:check && pnpm check && pnpm test && pnpm build && pnpm test:e2e && pnpm lhci"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "4.155.0"
  }
}
