---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const siteEntry = await getEntry('site', 'site');
if (!siteEntry) throw new Error('Missing site content entry.');
---

<BaseLayout
  title="履歷｜周泫淇 Syuan Ci"
  description={siteEntry.data.seo.description}
  site={siteEntry.data}
>
  <section class="placeholder-page">
    <h1>Resume Placeholder</h1>
    <p>The responsive web resume is intentionally deferred to M4.</p>
    <a href="/files/Syuan-Ci-Resume.pdf" download>
      Download PDF
    </a>
  </section>
</BaseLayout>
