---
import { getEntry } from 'astro:content';
import EntrySection from '../components/resume/EntrySection.astro';
import ResumeAbout from '../components/resume/ResumeAbout.astro';
import ResumeHeader from '../components/resume/ResumeHeader.astro';
import ResumeOverview from '../components/resume/ResumeOverview.astro';
import SkillsEducation from '../components/resume/SkillsEducation.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const siteEntry = await getEntry('site', 'site');
if (!siteEntry) throw new Error('Missing site content entry.');
const resumeEntry = await getEntry('resume', 'resume');
if (!resumeEntry) throw new Error('Missing resume content entry.');

const { data } = resumeEntry;
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  site={siteEntry.data}
>
  <div class="resume-surface">
    <div class="resume-page">
      <ResumeHeader data={data.header} />
      <ResumeOverview summary={data.summary} facts={data.facts} />
      <EntrySection
        data={data.experience}
        headingId="resume-experience-heading"
      />
      {data.earlier && (
        <EntrySection data={data.earlier} headingId="resume-earlier-heading" />
      )}
      <SkillsEducation skills={data.skills} education={data.education} />
      <ResumeAbout data={data.about} />
    </div>
  </div>
</BaseLayout>

<style>
  .resume-surface {
    background: var(--color-bg-surface);
  }

  .resume-page {
    display: grid;
    width: min(
      calc(100% - var(--layout-page-gutter) * 2),
      var(--layout-resume-content)
    );
    gap: var(--space-18);
    margin-inline: auto;
    padding-block: var(--space-16) var(--space-24);
  }

  @media (width >= 48rem) {
    .resume-page {
      gap: var(--space-24);
      padding-block-start: var(--space-24);
    }
  }
</style>
