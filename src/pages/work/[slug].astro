---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import CaseSections from '../../components/case/CaseSections.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getOrderedProjects } from '../../lib/project-content';
import { getNextProject } from '../../lib/projects';
import { createCreativeWorkStructuredData } from '../../lib/structured-data';
import '../../styles/case.css';

interface Props {
  project: CollectionEntry<'projects'>;
}

export async function getStaticPaths() {
  const projects = await getOrderedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const projects = await getOrderedProjects();
const nextProject = getNextProject(
  projects.map((entry) => ({
    ...entry,
    order: entry.data.order,
    slug: entry.id,
  })),
  project.id,
);
const siteEntry = await getEntry('site', 'site');
if (!siteEntry) throw new Error('Missing site content entry.');
const siteUrl = Astro.site;
if (!siteUrl) throw new Error('Astro.site must be configured.');
const structuredData = createCreativeWorkStructuredData({
  siteUrl,
  slug: project.id,
  name: project.data.name,
  nameZh: project.data.nameZh,
  description: project.data.seo.description,
});
---

<BaseLayout
  title={project.data.seo.title}
  description={project.data.seo.description}
  site={siteEntry.data}
  structuredData={structuredData}
  shareImage={{
    key: project.id,
    alt: `${project.data.name} 案例主視覺`,
  }}
  preloadBodyFont
>
  <CaseSections
    project={project}
    nextProject={nextProject}
    projectCount={projects.length}
  />
</BaseLayout>
