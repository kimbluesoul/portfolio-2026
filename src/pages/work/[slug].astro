---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import CaseSections from '../../components/case/CaseSections.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getOrderedProjects } from '../../lib/project-content';
import { getNextProject } from '../../lib/projects';
import '../../styles/case.css';

interface Props {
  project: CollectionEntry<'projects'>;
}

export async function getStaticPaths() {
  const projects = await getOrderedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const projects = await getOrderedProjects();
const nextProject = getNextProject(
  projects.map((entry) => ({
    ...entry,
    order: entry.data.order,
    slug: entry.id,
  })),
  project.id,
);
const siteEntry = await getEntry('site', 'site');
if (!siteEntry) throw new Error('Missing site content entry.');
---

<BaseLayout
  title={project.data.seo.title}
  description={project.data.seo.description}
  site={siteEntry.data}
>
  <CaseSections
    project={project}
    nextProject={nextProject}
    projectCount={projects.length}
  />
</BaseLayout>
