---
import { getEntry } from 'astro:content';
import AboutSection from '../components/home/AboutSection.astro';
import HomeHero from '../components/home/HomeHero.astro';
import ProjectCard from '../components/home/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getOrderedProjects } from '../lib/project-content';

const siteEntry = await getEntry('site', 'site');
if (!siteEntry) throw new Error('Missing site content entry.');
const site = siteEntry.data;
const projects = await getOrderedProjects();
const [featuredProject, ...secondaryProjects] = projects;
if (!featuredProject) throw new Error('At least one project is required.');
---

<BaseLayout
  title="Syuan Ci — UI / Interaction Designer"
  description="Syuan Ci 的 UI、互動與動態設計作品集。"
  site={site}
>
  <HomeHero {...site.hero} credentials={site.credentials} />
  <section id="work" class="work" aria-labelledby="work-heading">
    <div class="work-heading">
      <p>SELECTED WORK</p>
      <h2 id="work-heading">
        精選作品 <span>01—07</span>
      </h2>
    </div>
    <reveal-on-view>
      <ProjectCard project={featuredProject} featured />
    </reveal-on-view>
    <div class="project-grid">
      {secondaryProjects.map((project) => (
        <reveal-on-view>
          <ProjectCard project={project} />
        </reveal-on-view>
      ))}
    </div>
  </section>
  <reveal-on-view>
    <AboutSection {...site.about} />
  </reveal-on-view>
</BaseLayout>

<style>
  .work {
    width: min(
      calc(100% - (2 * var(--layout-page-gutter))),
      var(--layout-home-max)
    );
    margin-inline: auto;
    padding-block: var(--space-2) var(--space-18);
  }

  .work-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-10);
  }

  .work-heading p {
    color: var(--color-text-brand);
    font-family: var(--font-family-display);
    font-size: var(--font-size-label);
    font-weight: 700;
  }

  .work-heading h2 {
    font-family: var(--font-family-body);
    font-size: var(--font-size-body);
    font-weight: 500;
  }

  .work-heading span {
    color: var(--color-text-secondary);
    font-family: var(--font-family-display);
  }

  .project-grid {
    display: grid;
    gap: var(--space-12);
    margin-block-start: var(--space-12);
  }

  @media (width >= 48rem) {
    .work {
      padding-block-end: var(--space-35);
    }

    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--layout-card-gap);
      margin-block-start: var(--layout-card-gap);
    }
  }
</style>
