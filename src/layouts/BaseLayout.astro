---
import type { CollectionEntry } from 'astro:content';
import instrumentSansLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import fontManifest from '../generated/font-manifest.json';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  site: CollectionEntry<'site'>['data'];
}

const { title, description, site } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link
      rel="preload"
      href={instrumentSansLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {fontManifest.home700Core && (
      <link
        rel="preload"
        href={fontManifest.home700Core}
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    )}
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">
      跳至主要內容
    </a>
    <SiteHeader nav={site.nav} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter
      backToTopLabel={site.footer.backToTopLabel}
      copyright={site.footer.copyright}
      email={site.contact.email}
      heading={site.footer.heading}
      linkedin={site.contact.linkedin}
      resumeLabel={site.footer.resumeLabel}
      subheading={site.footer.subheading}
    />
  </body>
</html>

<script src="../elements/reveal-on-view.ts"></script>
