---
/* eslint-disable astro/no-set-html-directive -- generated font CSS and serialized JSON-LD are trusted build output */
import { createHash } from 'node:crypto';
import type { CollectionEntry } from 'astro:content';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { bodyFontPreloadHref } from '../lib/font-preload';
import { pageKeyFromPath } from '../lib/page-key.mjs';
import { getShareImage } from '../lib/share-image';
import generatedFontCss from '../styles/noto-sans-tc.generated.css?raw';
import generatedPageFontCss from '../styles/noto-sans-tc.pages.generated.json';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  site: CollectionEntry<'site'>['data'];
  /** Preload the 400 `core` font (case pages, where the LCP is text). */
  preloadBodyFont?: boolean;
  shareImage?: { key: string; alt: string };
  structuredData?: object;
}

interface DeferredFontFace {
  src: string;
  weight: number;
  unicodeRange: string;
}

interface PageFonts {
  criticalCss: string;
  deferredFaces: DeferredFontFace[];
}

const {
  title,
  description,
  site,
  preloadBodyFont = false,
  structuredData,
  shareImage = {
    key: 'home',
    alt: 'Syuan Ci 周泫淇 — 介面設計・互動設計・動態設計・原型設計',
  },
} = Astro.props;
const bodyFontHref = preloadBodyFont
  ? bodyFontPreloadHref(generatedFontCss)
  : undefined;
const pageKey = pageKeyFromPath(Astro.url.pathname);
const pageFonts = (
  generatedPageFontCss as unknown as Record<string, PageFonts>
)[pageKey];
const pageFontCss = pageFonts?.criticalCss;
const deferredFaces = pageFonts?.deferredFaces ?? [];
const deferredFontCss = deferredFaces
  .map(
    ({ src, weight, unicodeRange }) => `@font-face {
  font-family: 'Noto Sans TC';
  font-style: normal;
  font-weight: ${weight};
  font-display: swap;
  src: url('${src}') format('woff2');
  unicode-range: ${unicodeRange};
}`,
  )
  .join('\n\n');
const pageFontHash = pageFontCss
  ? (`sha256-${createHash('sha256').update(pageFontCss).digest('base64')}` as const)
  : undefined;
const deferredFontHash = deferredFontCss
  ? (`sha256-${createHash('sha256').update(deferredFontCss).digest('base64')}` as const)
  : undefined;
if (pageFontHash) Astro.csp?.insertStyleHash(pageFontHash);
if (deferredFontHash) Astro.csp?.insertStyleHash(deferredFontHash);
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = getShareImage(shareImage.key);
const imageUrl = new URL(image.path, Astro.site);
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replaceAll('<', '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Syuan Ci" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content={image.type} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    {pageFontCss && <Fragment set:html={`<style>${pageFontCss}</style>`} />}
    {deferredFontCss && (
      <Fragment
        set:html={`<noscript><style>${deferredFontCss}</style></noscript>`}
      />
    )}
    {bodyFontHref && (
      <link
        rel="preload"
        href={bodyFontHref}
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    {serializedStructuredData && (
      <script
        type="application/ld+json"
        is:inline
        set:html={serializedStructuredData}
      />
    )}
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">
      跳至主要內容
    </a>
    <SiteHeader nav={site.nav} />
    <header-tone></header-tone>
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter
      backToTopLabel={site.footer.backToTopLabel}
      copyright={site.footer.copyright}
      email={site.contact.email}
      heading={site.footer.heading}
      linkedin={site.contact.linkedin}
      resumeLabel={site.footer.resumeLabel}
      subheading={site.footer.subheading}
    />
    {deferredFaces.length > 0 && (
      <deferred-fonts data-faces={JSON.stringify(deferredFaces)} />
    )}
  </body>
</html>

<script src="../elements/reveal-on-view.ts"></script>
<script src="../elements/header-tone.ts"></script>
<script src="../elements/deferred-fonts.ts"></script>
