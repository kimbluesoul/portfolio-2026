---
import type { CollectionEntry } from 'astro:content';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { bodyFontPreloadHref } from '../lib/font-preload';
import generatedFontCss from '../styles/noto-sans-tc.generated.css?raw';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  site: CollectionEntry<'site'>['data'];
  /** Preload the 400 `core` font (case pages, where the LCP is text). */
  preloadBodyFont?: boolean;
}

const { title, description, site, preloadBodyFont = false } = Astro.props;
const bodyFontHref = preloadBodyFont
  ? bodyFontPreloadHref(generatedFontCss)
  : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    {bodyFontHref && (
      <link
        rel="preload"
        href={bodyFontHref}
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">
      跳至主要內容
    </a>
    <SiteHeader nav={site.nav} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter
      backToTopLabel={site.footer.backToTopLabel}
      copyright={site.footer.copyright}
      email={site.contact.email}
      heading={site.footer.heading}
      linkedin={site.contact.linkedin}
      resumeLabel={site.footer.resumeLabel}
      subheading={site.footer.subheading}
    />
  </body>
</html>

<script src="../elements/reveal-on-view.ts"></script>
