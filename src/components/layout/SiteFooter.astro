---
import emailIcon from '../../assets/site/icon-email.svg';
import linkedinIcon from '../../assets/site/icon-linkedin.svg';

interface Props {
  backToTopLabel: string;
  copyright: string;
  email: string;
  heading: string;
  linkedin: string;
  resumeLabel: string;
  subheading: string;
}

const {
  backToTopLabel,
  copyright,
  email,
  heading,
  linkedin,
  resumeLabel,
  subheading,
} = Astro.props;
---

<footer id="contact" class="site-footer">
  <div class="footer-main">
    <div class="footer-copy">
      <p class="contact-title">{heading}</p>
      <p class="contact-subtitle">{subheading}</p>
    </div>
    <a class="back-to-top" href="#top">
      {backToTopLabel}
    </a>
  </div>
  <div class="contact-links" aria-label="聯絡方式">
    <a href={`mailto:${email}`}>
      <img src={emailIcon.src} width="20" height="20" alt="" />
      Email
    </a>
    <a href={linkedin} target="_blank" rel="noopener noreferrer">
      <img src={linkedinIcon.src} width="20" height="20" alt="" />
      LinkedIn
    </a>
  </div>
  <div class="footer-meta">
    <p>{copyright}</p>
    <a href="/resume/">{resumeLabel}</a>
  </div>
</footer>

<style>
  .site-footer {
    content-visibility: auto;
    contain-intrinsic-size: auto 24rem;
    padding: var(--space-14) var(--layout-page-gutter) var(--space-8);
    background: var(--color-bg-inverse);
    color: var(--color-text-on-inverse);
  }

  .footer-main,
  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .footer-copy {
    display: grid;
    gap: var(--space-3);
  }

  .contact-title {
    font-family: var(--font-family-display);
    font-size: var(--font-size-home-eyebrow);
    font-weight: 600;
    line-height: 1;
  }

  .contact-subtitle {
    color: var(--color-text-on-inverse-muted);
    font-family: var(--font-family-display);
    font-size: var(--font-size-body-compact);
  }

  a {
    color: var(--color-text-on-inverse);
    font-family: var(--font-family-display);
    text-decoration: none;
  }

  .back-to-top,
  .footer-meta {
    font-size: var(--font-size-label);
    font-weight: 500;
    letter-spacing: var(--letter-spacing-label);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    border: var(--header-border-width) solid var(--color-bg-inverse-raised);
    border-radius: var(--radius-pill);
  }

  .footer-meta a {
    color: var(--color-text-on-inverse-muted);
  }

  .contact-links a:hover {
    border-color: var(--color-text-on-inverse-muted);
  }

  .contact-links img {
    width: var(--space-5);
    height: var(--space-5);
  }

  .footer-meta {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-6);
    border-block-start: var(--header-border-width) solid
      var(--color-bg-inverse-raised);
    color: var(--color-text-on-inverse-muted);
  }

  @media (width >= 48rem) {
    .site-footer {
      contain-intrinsic-size: auto 20rem;
      padding-block-start: var(--space-18);
    }
  }
</style>
