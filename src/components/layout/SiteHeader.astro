---
import logo from '../../assets/site/logo.svg';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  nav: NavItem[];
}

const { nav } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Syuan Ci 首頁">
    <img src={logo.src} width="91" height="44" alt="Syuan Ci" />
  </a>
  <nav aria-label="主要導覽">
    <ul>
      {nav.map((item) => {
        const isActive =
          item.label === 'Work' &&
          (currentPath === '/' || currentPath.startsWith('/work/'));
        return (
          <li>
            <a
              href={item.href}
              class:list={{ active: isActive }}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 10;
    inset-block-start: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--layout-page-gutter);
    border-block-end: var(--header-border-width) solid
      var(--color-border-header);
    background: var(--color-bg-canvas);
    backdrop-filter: blur(10px);
  }

  ul {
    display: flex;
    gap: var(--space-1);
    padding: var(--space-1);
    border: var(--header-border-width) solid var(--color-border-default);
    border-radius: var(--radius-pill);
  }

  a {
    color: var(--color-text-primary);
    font-family: var(--font-family-display);
    font-size: var(--font-size-body-compact);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease-standard);
  }

  nav a {
    display: block;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
  }

  nav a.active {
    background: var(--color-bg-brand);
    color: var(--color-text-on-brand);
  }

  a:hover {
    color: var(--color-text-brand);
  }

  .brand {
    flex: 0 0 auto;
  }

  .brand img {
    width: 5.6875rem;
    height: 2.75rem;
  }

  @media (width >= 48rem) {
    .site-header {
      padding-block: var(--space-5);
    }
  }
</style>
