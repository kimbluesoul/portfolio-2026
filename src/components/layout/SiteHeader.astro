---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  nav: NavItem[];
}

const { nav } = Astro.props;
---

<header class="site-header">
  <a href="/">SYUAN CI</a>
  <nav aria-label="Primary navigation">
    <ul>
      {nav.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-inline: var(--space-8);
    border-block-end: var(--focus-ring-width) solid var(--color-border-default);
    background: var(--color-bg-surface);
  }

  ul {
    display: flex;
    gap: var(--space-4);
  }
</style>
