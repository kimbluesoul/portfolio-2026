---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  nav: NavItem[];
}

const { nav } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Syuan Ci 首頁">
    SYUAN CI
  </a>
  <nav aria-label="主要導覽">
    <ul>
      {nav.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 10;
    inset-block-start: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--layout-page-gutter);
    border-block-end: var(--header-border-width) solid
      var(--color-border-header);
    background: var(--color-bg-canvas);
    backdrop-filter: blur(10px);
  }

  ul {
    display: flex;
    gap: var(--space-6);
  }

  a {
    color: var(--color-text-primary);
    font-family: var(--font-family-display);
    font-size: var(--font-size-body-compact);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease-standard);
  }

  a:hover {
    color: var(--color-text-brand);
  }

  .brand {
    letter-spacing: -0.02em;
  }

  @media (width >= 48rem) {
    .site-header {
      padding-block: var(--space-5);
    }

    ul {
      gap: var(--space-10);
    }
  }
</style>
