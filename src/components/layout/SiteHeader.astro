---
import logo from '../../assets/site/logo.svg';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  nav: NavItem[];
}

const { nav } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Syuan Ci 首頁">
    <img src={logo.src} width="91" height="44" alt="Syuan Ci" />
  </a>
  <nav aria-label="主要導覽">
    <ul>
      {nav.map((item) => {
        const isActive =
          item.label === 'Work' &&
          (currentPath === '/' || currentPath.startsWith('/work/'));
        return (
          <li>
            <a
              href={item.href}
              class:list={{ active: isActive }}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 10;
    inset-block-start: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--layout-page-gutter);
    background: var(--color-bg-canvas);
  }

  /* Nav pill: mobile 473:917 (0.8× scale), desktop 360:3438 / items 466:895.
     Item states: default text-primary; hover bg-subtle; active bg-subtle + text-brand. */
  ul {
    --space-nav-gap: 0.2rem;
    --space-nav-inset: 0.3rem;

    display: flex;
    gap: var(--space-nav-gap);
    padding: var(--space-nav-inset);
    border: var(--header-border-width) solid var(--color-border-header);
    border-radius: var(--radius-pill);
    background: var(--color-bg-surface);
  }

  a {
    position: relative;
    color: var(--color-text-primary);
    font-family: var(--font-family-display);
    font-weight: 500;
    text-decoration: none;
  }

  /* ARCHITECTURE §10: tap targets ≥ 44 × 44 px. The visible pill and logo keep
     their Figma size; an invisible layer extends the hit area vertically. */
  a::after {
    position: absolute;
    inset-block: min(0px, calc((100% - var(--tap-target-min)) / 2));
    inset-inline: 0;
    content: '';
  }

  nav a {
    display: block;
    padding: var(--space-2) 0.9rem;
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    line-height: 0.9rem;
    transition: background-color var(--motion-duration-hover)
      var(--motion-ease-hover);
  }

  nav a:is(:hover, :focus-visible) {
    background: var(--color-bg-subtle);
  }

  nav a.active {
    background: var(--color-bg-subtle);
    color: var(--color-text-brand);
  }

  .brand {
    display: block;
    flex: 0 0 auto;
  }

  .brand img {
    width: 4.0788rem;
    height: 1.98rem;
  }

  @media (width >= 48rem) {
    .site-header {
      padding-block: var(--space-5);
    }

    ul {
      --space-nav-gap: var(--space-1);
      --space-nav-inset: 0.4375rem;
    }

    nav a {
      padding: var(--space-2-5) var(--space-4-5);
      font-size: 1rem;
      line-height: var(--space-4-5);
    }

    .brand img {
      width: 5.665rem;
      height: 2.75rem;
    }
  }
</style>
