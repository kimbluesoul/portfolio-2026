---
import AccentText from '../ui/AccentText.astro';

interface Props {
  body: string;
  heading: string;
  resumeLabel: string;
  skills: string[];
  tools: string[];
}

const { body, heading, resumeLabel, skills, tools } = Astro.props;
const paragraphs = body.split(/\n\n/u);
const lists = [
  { title: 'TOOLS', items: tools },
  { title: 'SKILLS', items: skills },
];
---

<section id="about" class="about" aria-labelledby="about-heading">
  <div class="about-inner">
    <div class="about-intro">
      <p class="eyebrow">ABOUT</p>
      <h2 id="about-heading">
        <AccentText text={heading} />
      </h2>
    </div>
    <div class="about-content">
      <div class="about-copy">
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="lists">
        {lists.map((list) => (
          <div class="list">
            <p class="eyebrow">{list.title}</p>
            <ul aria-label={list.title}>
              {list.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <a class="resume-link" href="/resume/">
        {resumeLabel} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Mobile 474:1256, desktop 451:662. */
  .about {
    content-visibility: auto;
    contain-intrinsic-size: auto 48rem;
    padding: var(--space-18) var(--layout-page-gutter);
    background: var(--color-bg-surface);
  }

  .about-inner {
    display: grid;
    width: min(100%, var(--layout-home-max));
    gap: var(--space-7);
    margin-inline: auto;
  }

  .about-intro {
    display: grid;
    gap: var(--space-4);
  }

  .eyebrow {
    color: var(--color-text-brand);
    font-family: var(--font-family-display);
    font-size: var(--font-size-label);
    font-weight: 500;
    letter-spacing: var(--letter-spacing-label);
  }

  h2 {
    font-family: var(--font-family-body);
    font-size: var(--font-size-about-display);
    font-weight: 700;
    line-height: var(--line-height-display);
  }

  .about-content {
    display: grid;
    gap: var(--space-7);
  }

  .about-copy {
    display: grid;
    gap: var(--space-4);
  }

  .about-copy p {
    font-size: var(--font-size-card-summary);
    line-height: var(--line-height-about-body);
  }

  .about-copy p + p {
    color: var(--color-text-secondary);
  }

  .lists {
    display: grid;
    gap: var(--space-5);
  }

  .list {
    display: grid;
    gap: var(--space-2-5);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  li {
    padding: var(--space-1-5) var(--space-3);
    border: var(--header-border-width) solid var(--color-border-default);
    border-radius: var(--radius-tag);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.25rem;
  }

  .resume-link {
    display: inline-flex;
    justify-self: start;
    gap: var(--space-2);
    padding: 0.875rem var(--space-7);
    border-radius: var(--radius-pill);
    background: var(--color-bg-brand);
    color: var(--color-text-on-brand);
    font-family: var(--font-family-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.375rem;
    text-decoration: none;
    transition: background var(--motion-duration-fast)
      var(--motion-ease-standard);
  }

  .resume-link:hover {
    background: var(--color-bg-brand-hover);
  }

  @media (width >= 64rem) {
    .about {
      contain-intrinsic-size: auto 41rem;
      padding-block: var(--space-35);
    }

    .about-inner {
      grid-template-columns: 37% 50%;
      justify-content: space-between;
      gap: 0;
    }

    .about-intro {
      align-content: start;
      gap: var(--space-5);
    }

    .about-content {
      gap: var(--space-10);
    }

    .about-copy {
      gap: var(--space-5);
    }

    .lists {
      gap: var(--space-4);
    }

    /* Desktop 451:673: label (88 px) beside its tags on one row. */
    .list {
      grid-template-columns: 5.5rem 1fr;
      align-items: center;
      gap: var(--space-2);
    }
  }
</style>
