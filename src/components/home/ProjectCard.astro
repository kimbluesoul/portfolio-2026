---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const number = String(project.data.order).padStart(2, '0');
---

<article class:list={['project-card', { featured }]}>
  <a href={`/work/${project.id}/`}>
    <div class:list={['poster', `poster-${project.id}`]} aria-hidden="true">
      <div class="poster-window poster-window-main">
        <span>{project.data.name}</span>
      </div>
      <div class="poster-window poster-window-side"></div>
      <div class="poster-device"></div>
      <p>{number}</p>
    </div>
    <div class="card-copy">
      <div class="card-heading">
        <p>
          {number} — {project.data.name}
        </p>
        <h3>{project.data.nameZh}</h3>
      </div>
      <p class="summary">{project.data.card.summary}</p>
      <ul aria-label={`${project.data.name} 專案標籤`}>
        {project.data.card.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    </div>
  </a>
</article>

<style>
  .project-card a {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: transform var(--motion-duration-base)
      var(--motion-ease-standard);
  }

  .project-card a:hover,
  .project-card a:focus-visible {
    transform: translateY(calc(-1 * var(--space-1)));
  }

  .poster {
    position: relative;
    display: grid;
    min-height: 13.75rem;
    overflow: hidden;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-bg-subtle);
    isolation: isolate;
  }

  .poster::before {
    position: absolute;
    z-index: -1;
    inline-size: 58%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-project-accent-soft);
    content: '';
    inset-block-start: -24%;
    inset-inline-end: -8%;
  }

  .poster-window {
    align-self: center;
    border: var(--header-border-width) solid var(--color-border-default);
    background: var(--color-bg-surface);
    box-shadow: 0 var(--space-2) var(--space-6) var(--color-border-header);
  }

  .poster-window-main {
    display: grid;
    min-height: 70%;
    padding: var(--space-4);
    place-items: center;
    color: var(--color-text-brand);
    font-family: var(--font-family-display);
    font-size: var(--font-size-card-title);
    font-weight: 700;
    text-align: center;
  }

  .poster-window-side {
    min-height: 48%;
    background: linear-gradient(
      145deg,
      var(--color-bg-surface) 0 50%,
      var(--color-bg-brand) 50% 100%
    );
  }

  .poster-device {
    position: absolute;
    inline-size: 18%;
    aspect-ratio: 9 / 18;
    border: var(--space-1) solid var(--color-bg-inverse);
    border-radius: var(--space-3);
    background: var(--color-bg-surface);
    inset-block-end: var(--space-4);
    inset-inline-end: 25%;
    transform: rotate(5deg);
  }

  .poster > p {
    position: absolute;
    color: var(--color-text-secondary);
    font-family: var(--font-family-display);
    font-size: var(--font-size-label);
    font-weight: 700;
    inset-block-end: var(--space-3);
    inset-inline-start: var(--space-4);
  }

  .poster-fitzone,
  .poster-amd {
    background: var(--color-bg-inverse);
  }

  .poster-fitzone .poster-window-main,
  .poster-amd .poster-window-main {
    background: var(--color-bg-inverse-raised);
    color: var(--color-text-on-inverse);
  }

  .poster-sss .poster-window-main,
  .poster-jhanyu .poster-window-main {
    background: var(--color-project-accent-soft);
  }

  .poster-huifa .poster-window-side {
    background: var(--color-bg-inverse-raised);
  }

  .card-copy {
    display: grid;
    gap: var(--space-4);
  }

  .card-heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-start: var(--space-4);
    border-block-start: var(--header-border-width) solid
      var(--color-border-default);
  }

  .card-heading p,
  .card-heading h3 {
    font-family: var(--font-family-display);
    font-size: var(--font-size-card-title);
    font-weight: 600;
    line-height: var(--line-height-label);
  }

  .summary {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-compact);
    line-height: var(--line-height-body);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  li {
    padding: var(--space-1) var(--space-3);
    border: var(--header-border-width) solid var(--color-border-default);
    font-family: var(--font-family-display);
    font-size: var(--font-size-label);
  }

  @media (width >= 48rem) {
    .poster {
      min-height: 25rem;
      padding: var(--space-10);
    }

    .featured .poster {
      min-height: 34.875rem;
      grid-template-columns: 2fr 1fr;
    }

    .featured .card-copy {
      grid-template-columns: 1.1fr 1fr;
      column-gap: var(--space-10);
    }

    .featured ul {
      grid-column: 1 / -1;
    }
  }
</style>
