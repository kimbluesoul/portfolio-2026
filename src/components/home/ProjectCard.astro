---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const number = String(project.data.order).padStart(2, '0');
const media = project.data.card.media;
if (media.kind !== 'image') {
  throw new Error(`Home card ${project.id} must use an image.`);
}
const widths = featured ? [350, 700, 1152, 1728] : [350, 700, 844];
const sizes = featured
  ? '(min-width: 48rem) calc(100vw - 12rem), calc(100vw - 2.5rem)'
  : '(min-width: 48rem) calc((100vw - 14.5rem) / 2), calc(100vw - 2.5rem)';
const isLatinTag = (tag: string) => /^[\x20-\x7e–]+$/u.test(tag);
---

<article class:list={['project-card', { featured }]}>
  <a href={`/work/${project.id}/`}>
    <div class="media">
      <Picture
        src={media.src}
        alt={media.alt}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        loading={featured ? 'eager' : 'lazy'}
        fetchpriority={featured ? 'high' : 'auto'}
        decoding="async"
      />
    </div>
    <div class="card-copy">
      <div class="card-heading">
        <p>
          {number} — {project.data.name}
        </p>
        <h3>{project.data.nameZh}</h3>
      </div>
      <p class="summary">{project.data.card.summary}</p>
      <ul aria-label={`${project.data.name} 專案標籤`}>
        {project.data.card.tags.map((tag) => (
          <li class:list={{ 'tag-latin': isLatinTag(tag) }}>{tag}</li>
        ))}
      </ul>
    </div>
  </a>
</article>

<style>
  .project-card a {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .project-card:not(.featured) {
    content-visibility: auto;
    contain-intrinsic-size: auto 24rem;
  }

  .media {
    overflow: hidden;
    aspect-ratio: 350 / 166;
    border-radius: var(--radius-card);
    background: var(--color-bg-subtle);
  }

  .featured .media {
    aspect-ratio: 7 / 4;
  }

  /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Copy block: mobile 474:1129 (gap 10), desktop 465:1055 (gap 16), featured 465:943 (gap 18, inset 10). */
  .card-copy {
    display: grid;
    gap: var(--space-2-5);
  }

  .card-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem var(--space-2-5);
    font-size: var(--font-size-card-title);
    font-weight: 700;
    line-height: var(--line-height-card-title);
  }

  .card-heading p {
    font-family: var(--font-family-display);
  }

  .card-heading h3 {
    font-family: var(--font-family-body);
    font-size: inherit;
    line-height: inherit;
  }

  .summary {
    color: var(--color-text-primary);
    font-size: var(--font-size-card-summary);
    line-height: var(--line-height-card-summary);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  li {
    padding: var(--space-1-5) var(--space-2);
    border: var(--header-border-width) solid var(--color-border-default);
    border-radius: var(--radius-tag);
    font-family: var(--font-family-body);
    font-size: var(--font-size-label);
    font-weight: 500;
    line-height: var(--line-height-tag);
  }

  .tag-latin {
    font-family: var(--font-family-display);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-card a {
      transition: transform var(--motion-duration-base)
        var(--motion-ease-standard);
    }

    .project-card a:hover,
    .project-card a:focus-visible {
      transform: translateY(calc(-1 * var(--space-1)));
    }

    /* stylelint-disable selector-pseudo-class-no-unknown */
    .media :global(img) {
      transition: transform var(--motion-duration-base)
        var(--motion-ease-standard);
    }

    .project-card a:hover .media :global(img),
    .project-card a:focus-visible .media :global(img) {
      transform: scale(1.02);
    }
    /* stylelint-enable selector-pseudo-class-no-unknown */
  }

  @media (width >= 48rem) {
    .project-card:not(.featured) {
      contain-intrinsic-size: auto 36rem;
    }

    .media {
      aspect-ratio: 844 / 400;
    }

    .featured .media {
      aspect-ratio: 1728 / 500;
    }

    .card-copy,
    .card-heading {
      gap: var(--space-4);
    }

    ul {
      gap: var(--space-2);
    }

    .featured a {
      gap: var(--space-7-5);
    }

    .featured .card-copy {
      gap: var(--space-4-5);
      padding-inline: var(--space-2-5);
    }

    .featured .card-heading {
      gap: var(--space-4-5);
    }
  }
</style>
