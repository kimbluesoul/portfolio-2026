---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const number = String(project.data.order).padStart(2, '0');
const media = project.data.card.media;
const widths = featured ? [350, 700, 1152, 1728] : [350, 700, 844];
const sizes = featured
  ? '(min-width: 48rem) calc(100vw - 12rem), calc(100vw - 2.5rem)'
  : '(min-width: 48rem) calc((100vw - 14.5rem) / 2), calc(100vw - 2.5rem)';
const compositeDesktopWidths = [350, 600];
const compositeDesktopSizes =
  '(min-width: 48rem) calc((100vw - 12rem) * 0.488426), calc((100vw - 2.5rem) * 1.008571)';
const compositePhoneWidths = [80, 160];
const compositePhoneSizes =
  '(min-width: 48rem) calc((100vw - 12rem) * 0.07), calc((100vw - 2.5rem) * 0.14)';
const isLatinTag = (tag: string) => /^[\x20-\x7e–]+$/u.test(tag);
---

<article class:list={['project-card', { featured }]}>
  <a href={`/work/${project.id}/`}>
    <div class="media">
      {media.kind === 'image' && (
        <Picture
          src={media.src}
          alt={media.alt}
          formats={['avif', 'webp']}
          widths={widths}
          sizes={sizes}
          loading={featured ? 'eager' : 'lazy'}
          fetchpriority={featured ? 'high' : 'auto'}
          decoding="async"
        />
      )}
      {media.kind === 'video' && (
        <>
          <Picture
            class="video-poster"
            src={media.poster}
            alt=""
            aria-hidden="true"
            formats={['avif', 'webp']}
            widths={widths}
            sizes={sizes}
            loading="lazy"
            decoding="async"
          />
          <loop-video
            class="card-video"
            data-state="idle"
            role="img"
            aria-label={media.alt}
          >
            <video muted playsinline preload="none" aria-hidden="true">
              <source data-src={media.src} type="video/mp4" />
            </video>
          </loop-video>
        </>
      )}
      {media.kind === 'composite' && (
        <>
          <Picture
            class="composite-background"
            src={media.background.src}
            alt={media.alt}
            formats={['avif', 'webp']}
            widths={widths}
            sizes={sizes}
            width={1728}
            height={500}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
          <loop-video class="card-composite" data-state="idle">
            <Picture
              class="composite-pc composite-poster"
              src={media.desktop.poster}
              alt=""
              aria-hidden="true"
              formats={['avif', 'webp']}
              widths={compositeDesktopWidths}
              sizes={compositeDesktopSizes}
              quality={70}
              loading="eager"
              decoding="async"
            />
            <Picture
              class="composite-phone composite-poster"
              src={media.phone.poster}
              alt=""
              aria-hidden="true"
              formats={['avif', 'webp']}
              widths={compositePhoneWidths}
              sizes={compositePhoneSizes}
              quality={70}
              loading="eager"
              decoding="async"
            />
            <video
              class="composite-pc"
              muted
              playsinline
              preload="none"
              aria-hidden="true"
            >
              <source data-src={media.desktop.src} type="video/mp4" />
            </video>
            <video
              class="composite-phone"
              muted
              playsinline
              preload="none"
              aria-hidden="true"
            >
              <source data-src={media.phone.src} type="video/mp4" />
            </video>
          </loop-video>
        </>
      )}
    </div>
    <div class="card-copy">
      <div class="card-heading">
        <p>
          {number} — {project.data.name}
        </p>
        <h3>{project.data.nameZh}</h3>
      </div>
      <p class="summary">{project.data.card.summary}</p>
      <ul aria-label={`${project.data.name} 專案標籤`}>
        {project.data.card.tags.map((tag) => (
          <li class:list={{ 'tag-latin': isLatinTag(tag) }}>{tag}</li>
        ))}
      </ul>
    </div>
  </a>
</article>

<style>
  .project-card a {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .project-card:not(.featured) {
    content-visibility: auto;
    contain-intrinsic-size: auto 24rem;
  }

  .media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 350 / 166;
    border-radius: var(--radius-card);
    background: var(--color-bg-subtle);
  }

  .featured .media {
    aspect-ratio: 7 / 4;
  }

  /* stylelint-disable-next-line selector-pseudo-class-no-unknown */
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* stylelint-disable selector-pseudo-class-no-unknown */
  .media :global(loop-video),
  .media :global(video) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .media :global(video) {
    object-fit: cover;
  }

  .media :global(.card-video) {
    position: absolute;
    inset: 0;
  }

  .media :global(.card-composite) {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .composite-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 48%;
  }

  .media :global(.card-composite .composite-pc),
  .media :global(.card-composite .composite-phone),
  .media :global(.card-composite img.composite-poster) {
    position: absolute;
  }

  .media :global(.card-composite .composite-pc),
  .media :global(.card-composite img.composite-poster.composite-pc) {
    top: 0;
    left: -0.5714%;
    width: 100.8571%;
    height: 100%;
  }

  .media :global(.card-composite .composite-phone),
  .media :global(.card-composite img.composite-poster.composite-phone) {
    top: 50%;
    left: 76%;
    width: 16.5714%;
    height: 60%;
    overflow: hidden;
    border-radius: 15% / 7.25%;
  }
  /* stylelint-enable selector-pseudo-class-no-unknown */

  /* Copy block: mobile 474:1129 (gap 10), desktop 465:1055 (gap 16), featured 465:943 (gap 18, inset 10). */
  .card-copy {
    display: grid;
    gap: var(--space-2-5);
  }

  .card-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem var(--space-2-5);
    font-size: var(--font-size-card-title);
    font-weight: 700;
    line-height: var(--line-height-card-title);
  }

  .card-heading p {
    font-family: var(--font-family-display);
  }

  .card-heading h3 {
    font-family: var(--font-family-body);
    font-size: inherit;
    line-height: inherit;
  }

  .summary {
    color: var(--color-text-primary);
    font-size: var(--font-size-card-summary);
    line-height: var(--line-height-card-summary);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  li {
    padding: var(--space-1-5) var(--space-2);
    border: var(--header-border-width) solid var(--color-border-default);
    border-radius: var(--radius-tag);
    font-family: var(--font-family-body);
    font-size: var(--font-size-label);
    font-weight: 400;
    line-height: var(--line-height-tag);
  }

  .tag-latin {
    font-family: var(--font-family-display);
    font-weight: 500;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-card a {
      transition: transform var(--motion-duration-base)
        var(--motion-ease-standard);
    }

    .project-card a:hover,
    .project-card a:focus-visible {
      transform: translateY(calc(-1 * var(--space-1)));
    }

    /* stylelint-disable selector-pseudo-class-no-unknown */
    .media :global(img) {
      transition: transform var(--motion-duration-base)
        var(--motion-ease-standard);
    }

    .project-card a:hover .media :global(img),
    .project-card a:focus-visible .media :global(img) {
      transform: scale(1.02);
    }
    /* stylelint-enable selector-pseudo-class-no-unknown */
  }

  @media (width >= 48rem) {
    .project-card:not(.featured) {
      contain-intrinsic-size: auto 36rem;
    }

    .media {
      aspect-ratio: 844 / 400;
    }

    .featured .media {
      aspect-ratio: 1728 / 500;
    }

    /* stylelint-disable selector-pseudo-class-no-unknown */
    .composite-background {
      object-position: 50% 48%;
    }

    .media :global(.card-composite .composite-pc),
    .media :global(.card-composite img.composite-poster.composite-pc) {
      top: 16.2%;
      left: 22.9745%;
      width: 48.8426%;
      height: 95.4%;
    }

    .media :global(.card-composite .composite-phone),
    .media :global(.card-composite img.composite-poster.composite-phone) {
      top: 50%;
      left: 68.5764%;
      width: 8.4491%;
      height: 60.2%;
    }
    /* stylelint-enable selector-pseudo-class-no-unknown */

    .card-copy,
    .card-heading {
      gap: var(--space-4);
    }

    ul {
      gap: var(--space-2);
    }

    .featured a {
      gap: var(--space-7-5);
    }

    .featured .card-copy {
      gap: var(--space-4-5);
      padding-inline: var(--space-2-5);
    }

    .featured .card-heading {
      gap: var(--space-4-5);
    }
  }
</style>

<script src="../../elements/loop-video.ts"></script>
