---
import type { CollectionEntry } from 'astro:content';
import { caseTitleMobileClass } from '../../lib/case-title';
import { COMPOSITE_MEDIA_SIZES } from '../../lib/media-srcset';
import type { SectionTone } from '../../lib/sections';
import AccentText from '../ui/AccentText.astro';
import ProjectMedia from '../ui/ProjectMedia.astro';
import SectionShell from '../ui/SectionShell.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  tone: SectionTone;
}

const { project, tone } = Astro.props;
const { hero } = project.data;
// The first showcase image is the LCP element on phones (Lighthouse gate);
// AVIF q45 with full chroma stays under the old q50 4:2:0 byte size.
const HERO_LCP_QUALITY = 45;
const showcaseSizes =
  hero.showcase.layout === 'single' ? COMPOSITE_MEDIA_SIZES : undefined;
---

<SectionShell class="case-hero" tone={tone}>
  <a class="back-link" href="/#work">
    ← 所有作品
  </a>
  <div class="hero-copy">
    <p class="case-eyebrow">{hero.eyebrow}</p>
    <h1
      class:list={[
        hero.titleSizeMobile && caseTitleMobileClass(hero.titleSizeMobile),
      ]}
    >
      {hero.title}
    </h1>
    <p class="hero-headline">
      <AccentText text={hero.headline} />
    </p>
    <p class="hero-subtitle">{hero.subtitle}</p>
  </div>
  <dl class="hero-stats">
    {hero.stats.map((stat) => (
      <div>
        <dt>{stat.label}</dt>
        <dd>{stat.value}</dd>
      </div>
    ))}
  </dl>
  <div class:list={['hero-showcase', `layout-${hero.showcase.layout}`]}>
    {hero.showcase.items.map((media, index) => (
      <ProjectMedia
        media={media}
        mobileMedia={index === 0 ? hero.showcase.mobileMedia : undefined}
        eager={index === 0}
        sizes={showcaseSizes}
        quality={index === 0 ? HERO_LCP_QUALITY : undefined}
      />
    ))}
  </div>
</SectionShell>
