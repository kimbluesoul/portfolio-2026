---
import type { CollectionEntry } from 'astro:content';
import type { SectionTone } from '../../lib/sections';
import ProjectMedia from '../ui/ProjectMedia.astro';
import SectionIntro from '../ui/SectionIntro.astro';
import SectionShell from '../ui/SectionShell.astro';

interface Props {
  data: NonNullable<CollectionEntry<'projects'>['data']['mobile']>;
  tone: SectionTone;
}

const { data, tone } = Astro.props;
---

<SectionShell class="mobile-rwd" tone={tone}>
  <SectionIntro
    eyebrow={data.eyebrow}
    heading={data.heading}
    subtitle={data.subtitle}
  />
  <div class="mobile-panels">
    {data.panels.map((panel) => (
      <figure>
        <ProjectMedia media={panel.media} />
        <figcaption>
          <strong>{panel.title}</strong>
          {panel.caption}
        </figcaption>
      </figure>
    ))}
  </div>
</SectionShell>
