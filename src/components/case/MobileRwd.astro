---
/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- The mobile scroll-snap region must be keyboard-scrollable. */
import type { CollectionEntry } from 'astro:content';
import type { SectionTone } from '../../lib/sections';
import { PANEL_SLOT } from '../../lib/media-srcset';
import ProjectMedia from '../ui/ProjectMedia.astro';
import SectionIntro from '../ui/SectionIntro.astro';
import SectionShell from '../ui/SectionShell.astro';

interface Props {
  data: NonNullable<CollectionEntry<'projects'>['data']['mobile']>;
  tone: SectionTone;
}

const { data, tone } = Astro.props;
---

<SectionShell class="mobile-rwd" tone={tone}>
  <SectionIntro
    eyebrow={data.eyebrow}
    heading={data.heading}
    subtitle={data.subtitle}
  />
  <div
    class="mobile-panels swipe-row"
    tabindex="0"
    role="region"
    aria-label="手機畫面"
  >
    {data.panels.map((panel) => (
      <figure>
        <ProjectMedia media={panel.media} mediaSlot={PANEL_SLOT} />
        <figcaption>
          <strong>{panel.title}</strong>
          {panel.caption}
        </figcaption>
      </figure>
    ))}
  </div>
</SectionShell>
