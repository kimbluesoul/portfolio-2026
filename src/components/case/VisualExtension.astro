---
import type { CollectionEntry } from 'astro:content';
import { MOSAIC_MEDIA_SIZES } from '../../lib/media-srcset';
import type { SectionTone } from '../../lib/sections';
import ProjectMedia from '../ui/ProjectMedia.astro';
import SectionShell from '../ui/SectionShell.astro';

interface Props {
  data: NonNullable<CollectionEntry<'projects'>['data']['visualExtension']>;
  tone: SectionTone;
}

const { data, tone } = Astro.props;
---

<SectionShell class="visual-extension" tone={tone}>
  <h2 class="visually-hidden">Visual extension</h2>
  <reveal-on-view data-reveal-variant="signature">
    <div class:list={['visual-grid', `variant-${data.variant}`]}>
      {data.items.map((media, index) => (
        <ProjectMedia
          media={media}
          mobileMedia={index === 0 ? data.mobileMedia : undefined}
          sizes={data.variant === 'mosaic' ? MOSAIC_MEDIA_SIZES : undefined}
        />
      ))}
    </div>
  </reveal-on-view>
</SectionShell>
