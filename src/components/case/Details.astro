---
import type { CollectionEntry } from 'astro:content';
import type { SectionTone } from '../../lib/sections';
import { DETAIL_SLOTS, type MediaSlot } from '../../lib/media-srcset';
import ProjectMedia from '../ui/ProjectMedia.astro';
import SectionIntro from '../ui/SectionIntro.astro';
import SectionShell from '../ui/SectionShell.astro';
import ColorSwatches from './ColorSwatches.astro';

interface Props {
  data: NonNullable<CollectionEntry<'projects'>['data']['details']>;
  tone: SectionTone;
}

const { data, tone } = Astro.props;
const COMPARE_DRAFT_SLOT = {
  width: 1436,
  sizes: '(width < 48rem) 1107px, 1436px',
} satisfies MediaSlot;
---

<SectionShell class={`details details-${data.variant}`} tone={tone}>
  <SectionIntro
    eyebrow={data.eyebrow}
    heading={data.heading}
    subtitle={data.subtitle}
  />
  {data.variant === 'compare' ? (
    <div class="details-compare-items">
      {data.items.map((item, index) => (
        <figure class="detail-compare-item">
          <figcaption class="detail-eyebrow">{item.label}</figcaption>
          <div
            class:list={[
              'detail-compare-media',
              index === 0 && 'detail-compare-swipe',
            ]}
            tabindex={index === 0 ? '0' : undefined}
            role={index === 0 ? 'region' : undefined}
            aria-label={index === 0 ? '設計分鏡橫向捲動區' : undefined}
          >
            <ProjectMedia
              media={item.media}
              mediaSlot={index === 0 ? COMPARE_DRAFT_SLOT : undefined}
            />
          </div>
        </figure>
      ))}
    </div>
  ) : (
    <div class="details-grid">
      {data.items.map((item) => (
        <figure
          class={`detail-card size-${item.size ?? 'half'} ${item.media.kind === 'swatches' ? 'has-swatches' : ''}`}
        >
          {item.media.kind === 'swatches' ? (
            <>
              <figcaption>
                {item.eyebrow && (
                  <span class="detail-eyebrow">{item.eyebrow}</span>
                )}
                <strong>{item.title}</strong>
              </figcaption>
              {item.caption && <p class="swatch-caption">{item.caption}</p>}
              <ColorSwatches colors={item.media.colors} />
            </>
          ) : (
            <>
              <figcaption>
                {item.eyebrow && (
                  <span class="detail-eyebrow">{item.eyebrow}</span>
                )}
                <strong>{item.title}</strong>
                {item.caption && <span>{item.caption}</span>}
              </figcaption>
              <ProjectMedia
                media={item.media}
                mobileMedia={item.mobileMedia}
                mediaSlot={DETAIL_SLOTS[item.size ?? 'half']}
              />
            </>
          )}
        </figure>
      ))}
    </div>
  )}
</SectionShell>
