---
import type { CollectionEntry } from 'astro:content';
import type { SectionTone } from '../../lib/sections';
import ProjectMedia from '../ui/ProjectMedia.astro';
import SectionIntro from '../ui/SectionIntro.astro';
import SectionShell from '../ui/SectionShell.astro';

interface Props {
  data: NonNullable<CollectionEntry<'projects'>['data']['motion']>;
  tone: SectionTone;
}

const { data, tone } = Astro.props;
const baseId = 'case-motion';
---

<SectionShell class="interaction-motion" tone={tone}>
  <SectionIntro
    eyebrow={data.eyebrow}
    heading={data.heading}
    subtitle={data.subtitle}
  />
  <motion-steps>
    <div class="motion-stage">
      {data.steps.map((step, index) => (
        <div
          id={`${baseId}-panel-${index}`}
          role="tabpanel"
          aria-labelledby={`${baseId}-tab-${index}`}
          hidden={index !== 0}
        >
          <ProjectMedia media={step.media} />
        </div>
      ))}
    </div>
    <div
      class="motion-tabs"
      role="tablist"
      aria-label="互動步驟"
      data-step-count={data.steps.length}
    >
      {data.steps.map((step, index) => (
        <button
          id={`${baseId}-tab-${index}`}
          type="button"
          role="tab"
          aria-controls={`${baseId}-panel-${index}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          <strong>{step.title}</strong>
          <span>{step.body}</span>
        </button>
      ))}
    </div>
  </motion-steps>
</SectionShell>

<style>
  .motion-tabs[data-step-count='1'] {
    --motion-step-count: 1;
  }

  .motion-tabs[data-step-count='2'] {
    --motion-step-count: 2;
  }

  .motion-tabs[data-step-count='3'] {
    --motion-step-count: 3;
  }

  .motion-tabs {
    grid-template-columns: repeat(var(--motion-step-count), minmax(0, 1fr));
  }
</style>
