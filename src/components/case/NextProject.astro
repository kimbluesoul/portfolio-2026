---
import type { CollectionEntry } from 'astro:content';
import type { SectionTone } from '../../lib/sections';
import ProjectMedia from '../ui/ProjectMedia.astro';
import SectionShell from '../ui/SectionShell.astro';

interface Props {
  next: CollectionEntry<'projects'>;
  projectCount: number;
  tone: SectionTone;
}

const { next, projectCount, tone } = Astro.props;
const [firstNameWord, ...remainingNameWords] = next.data.name.split(' ');
// Figma spaces the `·` separators differently per width: full-width spaces at
// 1920 (`360:1368`) and normal spaces at 390 (`483:1515`). Content keeps one
// string, and the separator spacing is set in CSS.
const metaParts = next.data.next.meta.split(/\s*·\s*/u);
---

<SectionShell class="next-project" tone={tone}>
  {/* 360:1590 / 476:1929: back link | divider | eyebrow + counter, left-aligned. */}
  <div class="next-topline">
    <reveal-on-view>
      <a class="back-link" href="/#work" data-reveal-item>
        ← 所有作品
      </a>
      <span class="next-divider" aria-hidden="true" data-reveal-item></span>
      <p class="case-eyebrow" data-reveal-item>
        NEXT PROJECT{' '}
        <span class="next-counter">
          {String(next.data.order).padStart(2, '0')} /{' '}
          {String(projectCount).padStart(2, '0')}
        </span>
      </p>
    </reveal-on-view>
  </div>
  <a href={`/work/${next.id}/`}>
    <reveal-on-view>
      <div class="next-heading">
        <h2>
          {firstNameWord}
          {remainingNameWords.length > 0 && (
            <>
              <br class="next-name-break" /> {remainingNameWords.join(' ')}
            </>
          )}
        </h2>
        <span class="next-arrow" aria-hidden="true">
          <span class="next-arrow-glyph">→</span>
        </span>
      </div>
    </reveal-on-view>
    <reveal-on-view>
      <div data-reveal-item>
        <p class="next-meta">
          {metaParts.map((part, index) => (
            <>
              {index > 0 && (
                <>
                  {' '}
                  <span class="next-meta-separator">·</span>{' '}
                </>
              )}
              {part}
            </>
          ))}
        </p>
        <p class="next-body">{next.data.next.oneLiner}</p>
      </div>
    </reveal-on-view>
    <reveal-on-view>
      <ProjectMedia class="next-preview" media={next.data.next.media} />
    </reveal-on-view>
  </a>
</SectionShell>
