---
import type { CollectionEntry } from 'astro:content';
import type { MediaSlot } from '../../lib/media-srcset';
import LoopVideo from './LoopVideo.astro';
import ResponsivePicture from './ResponsivePicture.astro';

type ProjectData = CollectionEntry<'projects'>['data'];
type Media = ProjectData['hero']['showcase']['items'][number];

interface Props {
  media: Media;
  mobileMedia?: Media | undefined;
  eager?: boolean;
  class?: string | undefined;
  sizes?: string | undefined;
  mediaSlot?: MediaSlot | undefined;
  quality?: number | undefined;
}

const {
  class: className,
  eager = false,
  media,
  mobileMedia,
  sizes,
  mediaSlot,
  quality,
} = Astro.props;
---

{media.kind === 'image' ? (
  <ResponsivePicture
    media={media}
    mobileMedia={mobileMedia?.kind === 'image' ? mobileMedia : undefined}
    eager={eager}
    class={className}
    sizes={sizes}
    mediaSlot={mediaSlot}
    quality={quality}
  />
) : media.kind === 'video' ? (
  <LoopVideo
    media={media}
    eager={eager}
    class={className}
    mediaSlot={mediaSlot}
  />
) : null}
