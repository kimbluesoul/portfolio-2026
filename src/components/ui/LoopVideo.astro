---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
  DEFAULT_MEDIA_SIZES,
  srcsetWidthsFor,
  type MediaSlot,
} from '../../lib/media-srcset';
import MediaFrame from './MediaFrame.astro';

interface Props {
  media: {
    alt: string;
    aspectRatio?: string | undefined;
    expectedFile?: string | undefined;
    poster: ImageMetadata;
    src: string;
    status?: 'pending' | undefined;
  };
  eager?: boolean;
  class?: string | undefined;
  mediaSlot?: MediaSlot | undefined;
  'data-playback'?: string | undefined;
}

const {
  class: className,
  eager = false,
  media,
  mediaSlot,
  'data-playback': dataPlayback,
} = Astro.props;
const sizes = mediaSlot?.sizes ?? DEFAULT_MEDIA_SIZES;
const pending = media.status === 'pending';
const poster = await getImage({
  src: media.poster,
  format: 'avif',
  // The video paints over the poster, so it can trade quality for bytes
  // (posters start loading inside the phone LCP window).
  quality: 45,
  widths: srcsetWidthsFor(media.poster.width, mediaSlot?.width),
  sizes,
});
---

<loop-video
  class={className}
  data-playback={dataPlayback}
  data-state={pending ? 'pending' : 'idle'}
  aria-label={media.alt}
>
  <MediaFrame aspectRatio={media.aspectRatio} pending={pending}>
    {/*
      The poster is an image layer, not the `poster` attribute: browsers fetch
      a video poster eagerly, so a below-the-fold poster competed with the LCP
      for bandwidth (ARCHITECTURE §7 v1.9, §13). The video paints over it.
    */}
    <img
      class="video-poster"
      src={poster.src}
      srcset={poster.srcSet.attribute}
      sizes={sizes}
      width={poster.attributes.width}
      height={poster.attributes.height}
      alt=""
      aria-hidden="true"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
    <video muted playsinline controls preload="none" aria-label={media.alt}>
      {!pending && <source data-src={media.src} type="video/mp4" />}
    </video>
  </MediaFrame>
</loop-video>

<style>
  loop-video {
    display: block;
  }

  .video-poster {
    position: absolute;
    inset: 0;
  }

  video {
    position: relative;
  }
</style>
