---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import MediaFrame from './MediaFrame.astro';

interface Props {
  media: {
    alt: string;
    aspectRatio?: string | undefined;
    expectedFile?: string | undefined;
    poster: ImageMetadata;
    src: string;
    status?: 'pending' | undefined;
  };
  class?: string | undefined;
}

const { class: className, media } = Astro.props;
const pending = media.status === 'pending';
const poster = await getImage({ src: media.poster, format: 'webp' });
---

<loop-video
  class={className}
  data-state={pending ? 'pending' : 'idle'}
  aria-label={media.alt}
>
  <MediaFrame aspectRatio={media.aspectRatio} pending={pending}>
    <video
      muted
      playsinline
      controls
      preload="none"
      poster={poster.src}
      aria-label={media.alt}
    >
      {!pending && <source data-src={media.src} type="video/mp4" />}
    </video>
  </MediaFrame>
</loop-video>

<style>
  loop-video {
    display: block;
  }
</style>
