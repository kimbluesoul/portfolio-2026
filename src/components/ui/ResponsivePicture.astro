---
import { getImage, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
  DEFAULT_MEDIA_SIZES,
  srcsetWidthsFor,
  type MediaSlot,
} from '../../lib/media-srcset';
import MediaFrame from './MediaFrame.astro';

interface ImageMedia {
  alt: string;
  aspectRatio?: string | undefined;
  decorative?: boolean | undefined;
  expectedFile?: string | undefined;
  objectPosition?: 'center' | 'top' | undefined;
  src: ImageMetadata;
  status?: 'pending' | undefined;
}

interface Props {
  media: ImageMedia;
  mobileMedia?: ImageMedia | undefined;
  eager?: boolean;
  class?: string | undefined;
  /** Rendered width for the srcset; defaults to the case column. */
  sizes?: string | undefined;
  /** Fixed desktop slot: its sizes win and its 1x / 2x widths join the srcset. */
  mediaSlot?: MediaSlot | undefined;
  /** Encoder quality override (1–100); the LCP hero trades a little quality for bytes. */
  quality?: number | undefined;
}

const {
  class: className,
  eager = false,
  media,
  mobileMedia,
  sizes: sizesProp,
  mediaSlot,
  quality,
} = Astro.props;
const sizes = mediaSlot?.sizes ?? sizesProp ?? DEFAULT_MEDIA_SIZES;
const srcsetWidths = srcsetWidthsFor(media.src.width, mediaSlot?.width);
// Art-directed phone crops fill the column (the 390 frames are full-bleed).
const MOBILE_ART_SIZES = '100vw';
const frameClass = [
  className,
  media.objectPosition === 'top' ? 'object-position-top' : undefined,
  mobileMedia ? 'has-mobile-art' : undefined,
  mobileMedia?.status === 'pending' && media.status !== 'pending'
    ? 'has-pending-mobile-art'
    : undefined,
]
  .filter(Boolean)
  .join(' ');
const artDirected = mobileMedia
  ? await Promise.all([
      getImage({
        src: mobileMedia.src,
        format: 'avif',
        widths: srcsetWidthsFor(mobileMedia.src.width),
        ...(quality === undefined ? {} : { quality }),
      }),
      getImage({
        src: mobileMedia.src,
        format: 'webp',
        widths: srcsetWidthsFor(mobileMedia.src.width),
      }),
      getImage({ src: media.src, format: 'avif', widths: srcsetWidths }),
      getImage({ src: media.src, format: 'webp', widths: srcsetWidths }),
      getImage({ src: media.src }),
    ])
  : undefined;
const artDirectedImageAttributes = artDirected
  ? {
      ...artDirected[4].attributes,
      loading: eager ? ('eager' as const) : ('lazy' as const),
      fetchpriority: eager ? ('high' as const) : ('auto' as const),
      decoding: 'async' as const,
    }
  : undefined;
---

<MediaFrame
  aspectRatio={media.aspectRatio}
  mobileAspectRatio={mobileMedia?.aspectRatio}
  class={frameClass}
  pending={media.status === 'pending' || mobileMedia?.status === 'pending'}
>
  {mobileMedia && artDirected ? (
    <picture>
      <source
        media="(width < 48rem)"
        srcset={artDirected[0].srcSet.attribute}
        sizes={MOBILE_ART_SIZES}
        type="image/avif"
      />
      <source
        media="(width < 48rem)"
        srcset={artDirected[1].srcSet.attribute}
        sizes={MOBILE_ART_SIZES}
        type="image/webp"
      />
      <source
        srcset={artDirected[2].srcSet.attribute}
        sizes={sizes}
        type="image/avif"
      />
      <source
        srcset={artDirected[3].srcSet.attribute}
        sizes={sizes}
        type="image/webp"
      />
      <img
        src={artDirected[4].src}
        {...artDirectedImageAttributes}
        alt={media.decorative ? '' : media.alt}
      />
    </picture>
  ) : (
    <Picture
      src={media.src}
      formats={['avif']}
      fallbackFormat="webp"
      widths={srcsetWidths}
      sizes={sizes}
      {...(quality === undefined ? {} : { quality })}
      alt={media.decorative ? '' : media.alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
  )}
</MediaFrame>
