---
import AccentText from './AccentText.astro';

interface Props {
  eyebrow: string;
  heading: string;
  subtitle?: string;
}

const { eyebrow, heading, subtitle } = Astro.props;
---

<header class="section-intro">
  <p class="case-eyebrow">{eyebrow}</p>
  <h2>
    <AccentText text={heading} />
  </h2>
  {subtitle && <p class="section-subtitle">{subtitle}</p>}
</header>
